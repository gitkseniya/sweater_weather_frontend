<div class="card text-center">
  <h1>Log In</h1>
</div>


  <div class="d-flex align-items-center">

<%= form_with url: login_path, method: :post, local: true do |f|%>

    <%= f.text_field :email %>
    <%= f.label :email, " Email" %><br>
    <%= f.password_field :password %>
    <%= f.label :password, "Password" %><br>
    <%= f.submit "Log In" %>
<% end %>
</div>
