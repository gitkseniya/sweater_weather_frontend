<div class="card text-center">
  <h1 class="mb-3">Welcome to the Roadtrip Planner!</h1>

  <br><br>
  For weather at a particular location, click here:

  <%= form_with url: "/weather", method: :get, local: true do |f| %>
    <%= f.text_field :city %>
    <button type="submit" class="btn btn-primary">Search</button>
  <% end %>

  <br><br>
  For roadtrip planning, you will need to log in or register:

  <br>

  <a class="btn btn-primary" href="/users/new" role="button">Register</a>
  <a class="btn btn-primary" href="/login" role="button">Login</a>
</div>
