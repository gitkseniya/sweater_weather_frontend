<!DOCTYPE html>
<html>
  <head>
    <title>SweaterWeatherFrontend</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag 'application', media: 'all' %>
    <%= javascript_pack_tag 'application' %>
  </head>

  <body>
    <%= yield %>
  </body>
  <% flash.each do |k, v| %>
    <div id="<%= k %>"><%= v %></div>
  <% end %>
</html>
